{
  "description": "A list's default is checked item by item.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "x": {
            "type": "list",
            "of": "integer",
            "max": 3,
            "default": [
              1,
              4
            ]
          }
        }
      }
    }
  },
  "error": {
    "error": "default",
    "path": "types.plant.fields.x.default"
  }
}
