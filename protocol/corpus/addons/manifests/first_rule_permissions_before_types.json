{
  "description": "permissions are checked before types.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "permissions": {
      "tend": ""
    },
    "types": {
      "plant": 1
    }
  },
  "error": {
    "error": "bound",
    "path": "permissions.tend"
  }
}
