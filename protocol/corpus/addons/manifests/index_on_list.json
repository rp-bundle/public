{
  "description": "A list is not indexable.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "x": {
            "type": "list",
            "of": "integer",
            "index": true
          }
        }
      }
    }
  },
  "error": {
    "error": "not_indexable",
    "path": "types.plant.fields.x.index"
  }
}
