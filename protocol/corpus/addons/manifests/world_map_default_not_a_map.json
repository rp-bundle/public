{
  "description": "A map field's default is a map's name, or a record left to it could never be written.",
  "manifest": {
    "namespace": "acme_npcs",
    "version": "1.0.0",
    "api": 1,
    "title": "NPCs",
    "types": {
      "npc": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "spot": {
            "type": "vector3",
            "required": true
          },
          "heading": {
            "type": "number",
            "min": 0,
            "max": 360,
            "default": 0
          },
          "bucket": {
            "type": "integer",
            "min": 0,
            "max": 65535,
            "default": 0
          },
          "model": {
            "type": "json",
            "max_bytes": 256,
            "engine": true
          },
          "shown": {
            "type": "boolean",
            "default": true
          },
          "reach": {
            "type": "number",
            "min": 0.5,
            "max": 100,
            "default": 2
          },
          "label": {
            "type": "string",
            "max_len": 48
          },
          "map": {
            "type": "string",
            "max_len": 64,
            "index": true,
            "default": "rp downtown"
          }
        },
        "world": {
          "kind": "point",
          "position": "spot",
          "map": "map"
        }
      }
    }
  },
  "error": {
    "error": "default",
    "path": "types.npc.fields.map.default"
  }
}
