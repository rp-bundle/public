{
  "description": "A world's dialog names a reference to a dialog tree (L1): a reference to anything else is not one.",
  "manifest": {
    "namespace": "acme_npcs",
    "version": "1.0.0",
    "api": 1,
    "title": "NPCs",
    "types": {
      "npc": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "spot": {
            "type": "vector3",
            "required": true
          },
          "heading": {
            "type": "number",
            "min": 0,
            "max": 360,
            "default": 0
          },
          "bucket": {
            "type": "integer",
            "min": 0,
            "max": 65535,
            "default": 0
          },
          "model": {
            "type": "json",
            "max_bytes": 256,
            "engine": true
          },
          "shown": {
            "type": "boolean",
            "default": true
          },
          "reach": {
            "type": "number",
            "min": 0.5,
            "max": 100,
            "default": 2
          },
          "label": {
            "type": "string",
            "max_len": 48
          },
          "map": {
            "type": "string",
            "max_len": 64,
            "index": true,
            "nullable": true
          },
          "talks": {
            "type": "ref",
            "to": "item"
          }
        },
        "world": {
          "kind": "ped",
          "position": "spot",
          "heading": "heading",
          "bucket": "bucket",
          "model": "model",
          "visible": "shown",
          "map": "map",
          "dialog": "talks"
        }
      }
    }
  },
  "error": {
    "error": "world_field",
    "path": "types.npc.world.dialog"
  }
}
