{
  "description": "A field's type is checked before its keys.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "x": {
            "type": "money",
            "colour": 1
          }
        }
      }
    }
  },
  "error": {
    "error": "unknown_value",
    "path": "types.plant.fields.x.type"
  }
}
