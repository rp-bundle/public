{
  "description": "There are no regular expressions.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "x": {
            "type": "string",
            "pattern": "^a+$"
          }
        }
      }
    }
  },
  "error": {
    "error": "unknown_key",
    "path": "types.plant.fields.x.pattern"
  }
}
