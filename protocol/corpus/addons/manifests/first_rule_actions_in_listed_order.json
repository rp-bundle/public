{
  "description": "Actions are checked in the order view, create, edit, delete.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "x": {
            "type": "boolean"
          }
        },
        "actions": {
          "delete": "x",
          "create": "y"
        }
      }
    }
  },
  "error": {
    "error": "unknown_permission",
    "path": "types.plant.actions.create"
  }
}
