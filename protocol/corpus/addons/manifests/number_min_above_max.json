{
  "description": "A number's min is at most its max.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "x": {
            "type": "number",
            "min": 0.5,
            "max": 0.25
          }
        }
      }
    }
  },
  "error": {
    "error": "bound",
    "path": "types.plant.fields.x.min"
  }
}
