{
  "description": "A JSON field is at most 4 KiB.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "x": {
            "type": "json",
            "max_bytes": 4097
          }
        }
      }
    }
  },
  "error": {
    "error": "bound",
    "path": "types.plant.fields.x.max_bytes"
  }
}
