{
  "description": "A list holds at most 64 items.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "x": {
            "type": "list",
            "of": "boolean",
            "max_items": 65
          }
        }
      }
    }
  },
  "error": {
    "error": "bound",
    "path": "types.plant.fields.x.max_items"
  }
}
