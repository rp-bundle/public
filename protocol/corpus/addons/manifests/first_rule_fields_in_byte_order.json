{
  "description": "Fields are checked in byte order of name.",
  "manifest": {
    "namespace": "acme_garden",
    "version": "1.0.0",
    "api": 1,
    "title": "Garden",
    "types": {
      "plant": {
        "schema": 1,
        "authority": "config",
        "fields": {
          "b": {
            "type": "nope"
          },
          "a": {
            "type": 1
          }
        }
      }
    }
  },
  "error": {
    "error": "wrong_type",
    "path": "types.plant.fields.a.type"
  }
}
